      ]
    },
    "ExtensionSettings": {
      "isthepagereal@bruinsmakantoor.nl": {
        "installation_mode": "force_installed",
        "install_url": "",
        "default_area": "navbar"
      }
    },
    "3rdparty": {
      "Extensions": {
        "isthepagereal@bruinsmakantoor.nl": {
          "showNotifications": true,
          "enableValidPageBadge": true,
          "validPageBadgeTimeout": 5,
